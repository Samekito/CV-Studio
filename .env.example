# Copy to .env.local for local dev. On Vercel, add the same names under
# Project > Settings > Environment Variables.

# Required. Supabase holds accounts, Fact Banks, trackers and usage.
# Supabase > Project Settings > API: the Project URL, the anon (publishable) key and the
# service_role (secret) key. All three are read on the server only; never add a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Required. Your own account's id: that account is the admin (no daily limit, the Admin page).
# Supabase > Authentication > Users > your row > copy the UID. Differs per Supabase project.
ADMIN_USER_ID=

# Optional. Generations per user per UTC day (the admin is exempt). Default 10.
DAILY_GENERATION_LIMIT=10

# AI engine: "gemini" or "anthropic" (pay as you go).
LLM_PROVIDER=gemini

# Gemini: key from https://aistudio.google.com/apikey
# With other people's CVs going through it, use a key with billing enabled (paid tier).
GEMINI_API_KEY=
# Optional override if Google retires the default model.
GEMINI_MODEL=gemini-3.8-flash
# Optional. Tried in order when the main model is overloaded (the default is shown).
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest

# Optional, free. Groq is the backup when Gemini is busy, and the model that fact-checks each
# tailored CV. Key from https://console.groq.com (API Keys). Without it, Gemini does both jobs.
GROQ_API_KEY=
# Optional. Groq model that writes when Gemini is busy. Default is openai/gpt-oss-120b.
GROQ_MODEL=
# Optional. Groq model that fact-checks. Default is openai/gpt-oss-120b. A different model has
# its own per-minute allowance, but must handle a ~6,500-token request on the free tier.
GROQ_CHECK_MODEL=

# Claude: key from https://platform.claude.com (needs prepaid credit)
ANTHROPIC_API_KEY=
# Optional. Default is claude-opus-5; claude-sonnet-5 costs less per CV.
ANTHROPIC_MODEL=
